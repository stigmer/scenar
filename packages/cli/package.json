{
  "name": "@scenar/cli",
  "version": "0.0.1",
  "description": "Scenar CLI — validate scenarios, generate narration, and render videos.",
  "type": "module",
  "bin": {
    "scenar": "./dist/bin/scenar.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./api": {
      "types": "./dist/src/api.d.ts",
      "import": "./dist/src/api.js",
      "default": "./dist/src/api.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc --build && node dist/bin/scenar.js pack examples/welcome-tour --out dist/example-bundle",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --config ../../vitest.config.ts",
    "lint": "echo 'lint placeholder'",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@scenar/core": "workspace:*",
    "@scenar/embed": "workspace:*",
    "@scenar/sdk": "workspace:*",
    "commander": "^13.0.0",
    "yaml": "^2.7.0"
  },
  "peerDependencies": {
    "echogarden": ">=2.0.0",
    "edge-tts-universal": ">=1.0.0",
    "remotion": "4.0.448",
    "@remotion/renderer": "4.0.448",
    "@remotion/bundler": "4.0.448",
    "vite": ">=6.0.0",
    "@vitejs/plugin-react": ">=4.3.0",
    "playwright": ">=1.50.0"
  },
  "peerDependenciesMeta": {
    "echogarden": {
      "optional": true
    },
    "edge-tts-universal": {
      "optional": true
    },
    "remotion": {
      "optional": true
    },
    "@remotion/renderer": {
      "optional": true
    },
    "@remotion/bundler": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "@vitejs/plugin-react": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@scenar/react": "workspace:*",
    "@scenar/remotion": "workspace:*",
    "remotion": "4.0.448",
    "@remotion/bundler": "4.0.448",
    "@remotion/renderer": "4.0.448",
    "echogarden": "^2.10.1",
    "edge-tts-universal": "^1.4.0",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright": "^1.50.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stigmer/scenar.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["scenar", "scenario", "cli", "narration", "tts", "validate", "yaml", "video", "render", "remotion"]
}
