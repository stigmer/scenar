{
  "name": "@scenar/stubs",
  "version": "0.0.1",
  "description": "Generated TypeScript stubs (protobuf-es v2) for the Scenar APIs.",
  "type": "module",
  "exports": {
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no tests for generated stubs'",
    "lint": "echo 'lint placeholder'",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "sideEffects": false,
  "license": "Apache-2.0",
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stigmer/scenar.git",
    "directory": "apis/stubs/ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["scenar", "protobuf", "stubs", "grpc", "connect"]
}
